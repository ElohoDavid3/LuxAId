# Database
DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET="your-nextauth-secret"

# SMTP / Email (required only when password reset emails are sent)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user"
SMTP_PASSWORD="password"
SMTP_FROM="noreply@yourdomain.com"

# Flutterwave Integration (added by the payment step)
FLW_PUBLIC_KEY="FLWPUBK_TEST-..."
FLW_SECRET_KEY="FLWSECK_TEST-..."
FLW_SECRET_HASH="your-webhook-secret-hash"

# WhatsApp Business Cloud API (Step 11)
WHATSAPP_APP_SECRET="your-meta-app-secret"
WHATSAPP_VERIFY_TOKEN="your-custom-verify-token"
WHATSAPP_ACCESS_TOKEN="your-system-level-access-token"

# Vercel Blob — product image uploads (create store at vercel.com/dashboard or `vercel blob` )
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
